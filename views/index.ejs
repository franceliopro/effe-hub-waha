<!DOCTYPE html>
<html lang="pt-BR" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hub de Integração SaaS</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = { darkMode: 'class' }
        function toggleDarkMode() { document.documentElement.classList.toggle('dark'); }
    </script>
</head>
<body class="bg-gray-50 text-gray-900 dark:bg-gray-900 dark:text-gray-100 min-h-screen transition-colors duration-300">

    <!-- Navegação Superior -->
    <nav class="shadow-sm border-b dark:border-gray-800 p-4 flex justify-between items-center" style="border-bottom-color: <%= config.cor_primaria %>;">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded shadow flex items-center justify-center text-white font-bold" style="background-color: <%= config.cor_primaria %>;">
                <%= config.nome_empresa ? config.nome_empresa.charAt(0) : 'H' %>
            </div>
            <h1 class="font-bold text-xl"><%= config.nome_empresa || 'Meu Hub' %></h1>
        </div>
        <button onclick="toggleDarkMode()" class="p-2 bg-gray-200 dark:bg-gray-800 rounded-lg hover:opacity-80">
            🌓 Tema
        </button>
    </nav>

    <!-- Área de Configuração -->
    <main class="max-w-4xl mx-auto mt-10 p-6 bg-white dark:bg-gray-800 rounded-xl shadow-lg">
        <h2 class="text-2xl font-semibold mb-6 border-b pb-2 dark:border-gray-700">Configurações de Integração</h2>
        
        <form action="/salvar-config" method="POST" class="space-y-6">
            
            <!-- Personalização da Empresa -->
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium mb-1">Nome da Empresa</label>
                    <input type="text" name="nome_empresa" value="<%= config.nome_empresa %>" class="w-full p-3 rounded bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 outline-none">
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">Cor Primária (Hexadecimal)</label>
                    <input type="color" name="cor_primaria" value="<%= config.cor_primaria %>" class="w-full h-12 rounded cursor-pointer border-none">
                </div>
            </div>

            <!-- WAHA Config -->
            <div class="p-4 bg-gray-100 dark:bg-gray-700 rounded-lg border-l-4" style="border-color: <%= config.cor_primaria %>;">
                <h3 class="font-bold mb-3">📡 Configurações do WAHA</h3>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm mb-1">URL Base Waha</label>
                        <input type="url" name="waha_url" placeholder="ex: https://waha.effe.site" value="<%= config.waha_url %>" class="w-full p-2 rounded bg-white dark:bg-gray-800 border dark:border-gray-600 outline-none">
                    </div>
                    <div>
                        <label class="block text-sm mb-1">Nome da Sessão Waha</label>
                        <input type="text" name="waha_session" placeholder="ex: default" value="<%= config.waha_session %>" class="w-full p-2 rounded bg-white dark:bg-gray-800 border dark:border-gray-600 outline-none">
                    </div>
                </div>
            </div>

            <!-- Typebot Config -->
            <div class="p-4 bg-gray-100 dark:bg-gray-700 rounded-lg border-l-4" style="border-color: <%= config.cor_primaria %>;">
                <h3 class="font-bold mb-3">🤖 Configurações do Typebot</h3>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm mb-1">URL de Visualização (Viewer)</label>
                        <input type="url" name="typebot_url" placeholder="ex: https://bot.effe.site" value="<%= config.typebot_url %>" class="w-full p-2 rounded bg-white dark:bg-gray-800 border dark:border-gray-600 outline-none">
                    </div>
                    <div>
                        <label class="block text-sm mb-1">Nome/ID do Fluxo</label>
                        <input type="text" name="typebot_nome_fluxo" placeholder="ex: atendimento-v1" value="<%= config.typebot_nome_fluxo %>" class="w-full p-2 rounded bg-white dark:bg-gray-800 border dark:border-gray-600 outline-none">
                    </div>
                </div>
            </div>

            <button type="submit" class="w-full py-3 mt-4 text-white font-bold rounded hover:opacity-90 transition-opacity" style="background-color: <%= config.cor_primaria %>;">
                Salvar Configurações e Iniciar Automação
            </button>
        </form>
    </main>
</body>
</html>